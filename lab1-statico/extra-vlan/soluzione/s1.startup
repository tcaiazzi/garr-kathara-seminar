# s1 fa da switch: nessun indirizzo IP, solo bridge.
# Porte di accesso: eth0 (pc1, VLAN 101) ed eth2 (pc4, VLAN 100). Trunk: eth1.
# Un frame entra senza tag dalla porta di accesso, il bridge lo inoltra alla
# sottointerfaccia del trunk, che lo invia su n12 con il tag della VLAN.

# VLAN 101: porta di accesso eth0 (pc1) + trunk eth1, taggato 101
ip link add link eth1 name eth1.101 type vlan id 101
ip link add br101 type bridge
ip link set eth0 master br101
ip link set eth1.101 master br101
ip link set eth1.101 up
ip link set br101 up

# VLAN 100: porta di accesso eth2 (pc4) + trunk eth1, taggato 100
ip link add link eth1 name eth1.100 type vlan id 100
ip link add br100 type bridge
ip link set eth2 master br100
ip link set eth1.100 master br100
ip link set eth1.100 up
ip link set br100 up
